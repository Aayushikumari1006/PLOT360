# PLOT360 Backend Environment Configuration Example
# Copy to .env and adjust variables as required

DATABASE_URL=postgresql://plot360:plot360secure@localhost:5432/plot360
SQLITE_FALLBACK_URL=sqlite:///./plot360_dev.db
POSTGIS_ENABLED=true

JWT_SECRET=plot360-jwt-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_ENV=development
DEBUG=true
# CORS allowed origins (comma-separated). In split deployment, append your frontend static site URL:
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8000

DATA_DIR=./data
STORAGE_PATH=./data/documents
MODEL_PATH=./data/models
MAX_UPLOAD_SIZE_MB=50

TESSERACT_CMD=
REDIS_URL=
